# License Server Configuration
# Copy this file to .env and update with your values
# DO NOT commit .env to version control!

# Admin API Key (CHANGE THIS IN PRODUCTION!)
ADMIN_API_KEY=admin-secret-key-change-in-production

# Server Configuration
PORT=5000
DEBUG=False

# Database (optional - comment out to use in-memory storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/licenses
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
