# AI Testing Agent — environment configuration
# Copy to .env and fill in your values. Never commit .env to version control.

# ──────────────────────────────────────────────
# Claude API (optional — mock AI used if absent)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# License key (optional — extended limits)
# ──────────────────────────────────────────────
AI_AGENT_LICENSE_KEY=

# ──────────────────────────────────────────────
# Telemetry (set to 1 to disable)
# ──────────────────────────────────────────────
AI_TESTING_NO_ANALYTICS=

# ──────────────────────────────────────────────
# License server (only needed for self-hosted deployment)
# ──────────────────────────────────────────────
# ADMIN_API_KEY=                  # generate with: openssl rand -hex 32
# PORT=5000
# DEBUG=False
# DATABASE_PATH=./data/licenses.db
# DATABASE_URL=postgresql://user:password@localhost:5432/licenses
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://your-domain.com
