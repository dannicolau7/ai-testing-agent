"""Backend tests: every operation in the API spec, checked against what the spec says.

What to check is in operations.json. Do not edit this file; edit that one, or generate again.
"""

import json
import os

import pytest

import support

with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "operations.json"), encoding="utf-8") as handle:
    OPERATIONS = json.load(handle)["operations"]


def _named(operations):
    return [pytest.param(o, id=o["name"]) for o in operations]


def _caller(operation):
    return support.signed_in("user") if operation["needs_sign_in"] else {}


@pytest.mark.parametrize("operation", _named(OPERATIONS))
def test_answers_as_the_spec_documents(operation):
    """The status is one the spec documents, and a success carries the fields the spec requires."""
    reply = support.send(operation["method"], operation["path"], _caller(operation), operation["body"])
    documented = operation["documented"]
    said = support._said(reply)
    if not documented:
        pytest.skip("the spec documents no status for this operation, so there is nothing to check against")
    if reply.status_code not in documented:
        if support._answer(reply) == "absent":
            pytest.skip("answered " + said + ", which the spec does not document. If the path has an id, set "
                        "PATH_IDS to one that exists")
        if support._answer(reply) == "refused" and operation["needs_sign_in"]:
            # Many specs leave 401 and 403 out. Being turned away says the test user lacks the
            # role for this operation, not that the operation breaks its contract.
            pytest.skip("the test user was turned away (" + said + "): this operation may need another role, "
                        "so its success was not checked")
        if support._answer(reply) == "unfinished":
            pytest.skip("turned the request down (" + said + "), which the spec does not document. The body "
                        "built from the spec was not accepted, so the success was not checked")
        assert False, (operation["name"] + " answered " + said + ". The spec documents: "
                       + ", ".join(str(code) for code in documented))
    if not 200 <= reply.status_code < 300:
        pytest.skip("answered " + said + ", which the spec documents, but it is not a success: the request "
                    "built from the spec was not accepted, so the success was not checked")
    required = operation["reply_required"].get(str(reply.status_code))
    if required:
        try:
            body = reply.json()
        except ValueError:
            assert False, operation["name"] + " answered " + said + " without the JSON the spec describes"
        if isinstance(body, dict):
            missing = [name for name in required if name not in body]
            assert not missing, (operation["name"] + " answered " + said + " without the field(s) the spec "
                                 "requires: " + ", ".join(missing))


@pytest.mark.parametrize("operation", _named([o for o in OPERATIONS if o["needs_sign_in"]]))
def test_refuses_a_caller_who_is_not_signed_in(operation):
    reply = support.send(operation["method"], operation["path"], {}, operation["body"])
    support._nothing_shown(reply, "PATH_IDS")
    assert support._answer(reply) == "refused", (
        operation["name"] + " let a caller through without signing in: " + support._said(reply))


@pytest.mark.parametrize("operation", _named([o for o in OPERATIONS if o["body_required"]]))
def test_turns_down_a_body_with_no_required_field(operation):
    """The spec requires these fields, so a body with none of them must not be accepted."""
    empty = {"json": {}} if "json" in (operation["body"] or {"json": 1}) else {"data": {}}
    reply = support.send(operation["method"], operation["path"], _caller(operation), empty)
    kind = support._answer(reply)
    if kind == "refused":
        pytest.skip("refused before the body was looked at (" + support._said(reply) + ")")
    if kind == "absent":
        pytest.skip("answered " + support._said(reply) + ": set PATH_IDS to an id that exists")
    assert kind != "error", (operation["name"] + " failed with " + support._said(reply) + " on a body missing "
                             + ", ".join(operation["body_required"]) + ". It should turn the body down, not crash")
    assert kind == "unfinished", (operation["name"] + " accepted a body with none of the required fields ("
                                  + ", ".join(operation["body_required"]) + "): " + support._said(reply))
