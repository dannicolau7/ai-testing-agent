"""Frontend and backend together: a requirement carried out in the page, then checked in the backend.

A journey passes when its steps work in the page, the page sends the request it should and the
server accepts it, and afterwards the backend holds the result. What to check is in
journeys.json. Do not edit this file; edit that one, or generate again.

A journey does what its steps say, including saving and deleting, so it runs only with
AUTOMATION_ALLOW_WRITES=1.
"""

import json
import os
import re
from urllib.parse import urlparse

import pytest

import support

with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "journeys.json"), encoding="utf-8") as handle:
    JOURNEYS = json.load(handle)["journeys"]


@pytest.fixture(scope="module")
def browser():
    manager, chrome = support.start_browser()
    yield chrome
    chrome.close()
    manager.stop()


def _first(*locators):
    for locator in locators:
        if locator.count() > 0:
            return locator.first
    return None


def _same_route(wanted, actual):
    blank = re.sub(r"\{[^}]*\}|<[^>]*>|:[A-Za-z_][A-Za-z0-9_]*", "{}", wanted).rstrip("/")
    return bool(re.match("^" + re.escape(blank).replace(r"\{\}", "[^/]+") + "/?$", actual))


@pytest.mark.parametrize("journey", [pytest.param(j, id=j["id"] + " " + j["name"]) for j in JOURNEYS])
def test_journey(browser, journey):
    if not support.WRITES:
        pytest.skip("a journey saves and deletes as its steps say: set AUTOMATION_ALLOW_WRITES=1 to run it")
    from playwright.sync_api import expect

    origin = "{0.scheme}://{0.netloc}".format(urlparse(support.BASE))
    calls = []

    def on_response(response):
        request = response.request
        if request.resource_type in ("fetch", "xhr") and response.url.startswith(origin):
            calls.append((request.method, urlparse(response.url).path or "/", response.status))

    holder = support.browser_page(browser, "journey " + journey["id"])
    with holder as page:
        page.on("response", on_response)
        quiet = support.Quiet(page)
        for number, step in enumerate(journey["steps"], 1):
            (kind, value), = step.items()
            where = "step " + str(number) + " (" + kind + ")"
            if kind == "open":
                reply = page.goto(support.BASE + "/" + str(value).lstrip("/"), wait_until="networkidle")
                assert reply is not None and reply.status < 400, where + ": the page " + str(value) + " did not load"
            elif kind == "fill":
                name = str(value["field"])
                target = _first(page.get_by_label(name, exact=False), page.get_by_placeholder(name, exact=False),
                                page.locator('[name="' + name + '"]'))
                assert target is not None, where + ": no field called “" + name + "” on the page"
                target.fill(str(value["value"]))
            elif kind == "click":
                target = _first(page.get_by_role("button", name=str(value), exact=False),
                                page.get_by_role("link", name=str(value), exact=False),
                                page.get_by_text(str(value), exact=False))
                assert target is not None, where + ": nothing to click called “" + str(value) + "”"
                target.click()
                quiet.wait()                                   # until the requests the click started are done
            elif kind == "see":
                # Playwright's own assertion keeps looking until the text shows or time runs out.
                try:
                    expect(page.get_by_text(str(value), exact=False).first).to_be_visible()
                except AssertionError:
                    assert False, where + ": the page does not show “" + str(value) + "”"
            elif kind == "not_see":
                try:
                    expect(page.get_by_text(str(value), exact=False)).to_have_count(0)
                except AssertionError:
                    assert False, where + ": the page shows “" + str(value) + "”, which it must not"

        if journey.get("page_must_call"):
            method, path = journey["page_must_call"]
            sent = [c for c in calls if c[0] == method and _same_route(path, c[1])]
            seen = ", ".join(m + " " + u for m, u, _ in calls) or "no request at all"
            assert sent, "the page never sent " + method + " " + path + ". It sent: " + seen
            assert any(status < 400 for _, _, status in sent), (
                "the page sent " + method + " " + path + " and the server answered " + str(sent[-1][2])
                + ", while the page went on as if it had worked")

        if journey.get("backend_get"):
            reply = holder.context.request.get(support.BASE + "/" + journey["backend_get"].lstrip("/"),
                                               headers=holder.site_headers)
            assert reply.status < 400, "GET " + journey["backend_get"] + " answered " + str(reply.status)
            body = reply.text()
            if journey.get("backend_contains"):
                assert journey["backend_contains"] in body, (
                    "the page showed it worked, but GET " + journey["backend_get"] + " does not contain “"
                    + journey["backend_contains"] + "”. The frontend and the backend disagree")
            if journey.get("backend_not_contains"):
                assert journey["backend_not_contains"] not in body, (
                    "the page showed it worked, but GET " + journey["backend_get"] + " still contains “"
                    + journey["backend_not_contains"] + "”. The frontend and the backend disagree")
