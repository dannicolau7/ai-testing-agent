"""Frontend tests: every page the browser reached when this suite was written.

A page passes when it loads, throws no error, and none of its own requests fail. What to check
is in pages.json. Do not edit this file; edit that one, or generate again.
"""

import json
import os
from urllib.parse import urlparse

import pytest

import support

with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "pages.json"), encoding="utf-8") as handle:
    PAGES = json.load(handle)["pages"]


@pytest.fixture(scope="module")
def browser():
    manager, chrome = support.start_browser()
    yield chrome
    chrome.close()
    manager.stop()


@pytest.mark.parametrize("page_info", [pytest.param(p, id=p["path"]) for p in PAGES])
def test_page_loads_without_errors(browser, page_info):
    origin = "{0.scheme}://{0.netloc}".format(urlparse(support.BASE))
    errors, failed = [], []

    def on_console(message):
        # The browser logs every failed request to the console as well. Those are reported
        # below with the address that failed, which says more.
        if message.type == "error" and not message.text.startswith("Failed to load resource"):
            errors.append(message.text[:160])

    def on_response(response):
        request = response.request
        path = urlparse(response.url).path or "/"
        if not response.url.startswith(origin) or request.is_navigation_request():
            return
        if request.resource_type in ("fetch", "xhr"):
            bad = response.status in (404, 405) or response.status >= 500
        else:   # a script, style sheet or image the page asked for. A missing favicon is not a fault.
            bad = response.status >= 400 and not path.endswith("/favicon.ico")
        if bad:
            failed.append(request.method + " " + path + " answered " + str(response.status))

    with support.browser_page(browser, "page " + page_info["path"]) as page:
        page.on("pageerror", lambda exc: errors.append(str(exc).splitlines()[0][:160]))
        page.on("console", on_console)
        page.on("response", on_response)
        try:
            reply = page.goto(support.BASE + page_info["path"], wait_until="networkidle", timeout=20000)
        except Exception as exc:  # noqa: BLE001 - whatever stopped the page from loading
            if any(sign in str(exc) for sign in ("ERR_CONNECTION", "ERR_NAME_NOT_RESOLVED", "ERR_ADDRESS",
                                                   "ERR_TIMED_OUT", "ERR_INTERNET_DISCONNECTED")):
                pytest.skip("could not reach " + support.BASE)
            assert False, page_info["path"] + " did not load: " + str(exc).splitlines()[0][:160]
        status = reply.status if reply is not None else 0
        assert status and status < 400, page_info["path"] + " answered " + str(status or "nothing")
        assert not errors, page_info["path"] + " threw: " + "; ".join(errors[:3])
        assert not failed, page_info["path"] + " made request(s) that failed: " + "; ".join(failed[:3])
